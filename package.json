{
  "name": "tree-sitter-cmd",
  "version": "0.1.0",
  "description": "Tree-sitter grammar for Windows cmd.exe / batch (.bat, .cmd) scripts",
  "license": "MIT",
  "keywords": [
    "tree-sitter",
    "parser",
    "cmd",
    "batch",
    "bat",
    "windows",
    "cmd.exe"
  ],
  "scripts": {
    "generate": "tree-sitter generate",
    "test": "tree-sitter test",
    "parse": "tree-sitter parse"
  },
  "devDependencies": {
    "tree-sitter-cli": "^0.26.11"
  },
  "tree-sitter": [
    {
      "scope": "source.dosbatch",
      "file-types": [
        "bat",
        "cmd"
      ],
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "injection-regex": "^(bat|batch|cmd|dosbatch)$"
    }
  ]
}
