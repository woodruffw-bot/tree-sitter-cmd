{
  "name": "tree-sitter-cmd",
  "version": "0.1.0",
  "description": "Tree-sitter grammar for Windows cmd.exe / batch (.bat, .cmd) scripts",
  "license": "MIT",
  "keywords": [
    "tree-sitter",
    "parser",
    "cmd",
    "batch",
    "bat",
    "windows",
    "cmd.exe"
  ],
  "main": "bindings/node",
  "types": "bindings/node",
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "scripts": {
    "install": "node-gyp-build",
    "generate": "tree-sitter generate",
    "test": "tree-sitter test",
    "test:bindings": "node --test bindings/node/*_test.js",
    "parse": "tree-sitter parse"
  },
  "dependencies": {
    "node-addon-api": "^8.0.0",
    "node-gyp-build": "^4.8.0"
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "tree-sitter-cli": "^0.25.10"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "tree-sitter": [
    {
      "scope": "source.dosbatch",
      "file-types": [
        "bat",
        "cmd"
      ],
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "injection-regex": "^(bat|batch|cmd|dosbatch)$"
    }
  ]
}
