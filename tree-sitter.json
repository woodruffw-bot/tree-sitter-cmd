{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "cmd",
      "camelcase": "Cmd",
      "scope": "source.dosbatch",
      "file-types": [
        "bat",
        "cmd"
      ],
      "injection-regex": "^(bat|batch|cmd|dosbatch)$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for Windows cmd.exe / batch scripts",
    "authors": [
      {
        "name": "tree-sitter-cmd contributors"
      }
    ],
    "links": {
      "repository": "https://github.com/woodruffw-bot/tree-sitter-cmd"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": false
  }
}
