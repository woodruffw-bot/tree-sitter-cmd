* text=auto eol=lf

# Real-world test fixtures are third-party files stored verbatim (preserving
# original CRLF/LF, upstream trailing whitespace, and bytes); never normalize
# or whitespace-fix them.
test/real-world/fixtures/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol

# Generated source files
src/*.json linguist-generated
src/parser.c linguist-generated
src/tree_sitter/* linguist-generated

# Rust bindings
bindings/rust/* linguist-generated
Cargo.toml linguist-generated
Cargo.lock linguist-generated
