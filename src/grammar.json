{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "cmd",
  "rules": {
    "program": {
      "type": "SEQ",
      "members": [
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_line"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_line_content"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_line_content"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_newline"
        }
      ]
    },
    "_line_content": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_statement"
        },
        {
          "type": "SYMBOL",
          "name": "label"
        },
        {
          "type": "SYMBOL",
          "name": "colon_comment"
        }
      ]
    },
    "_newline": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\r?\\n"
      }
    },
    "line_continuation": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\^\\r?\\n[ \\t]*"
      }
    },
    "_statement": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_unit"
        },
        {
          "type": "SYMBOL",
          "name": "seq_list"
        },
        {
          "type": "SYMBOL",
          "name": "or_list"
        },
        {
          "type": "SYMBOL",
          "name": "and_list"
        },
        {
          "type": "SYMBOL",
          "name": "pipeline"
        }
      ]
    },
    "seq_list": {
      "type": "PREC_LEFT",
      "value": 1,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "left",
            "content": {
              "type": "SYMBOL",
              "name": "_statement"
            }
          },
          {
            "type": "STRING",
            "value": "&"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "FIELD",
                "name": "right",
                "content": {
                  "type": "SYMBOL",
                  "name": "_statement"
                }
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "or_list": {
      "type": "PREC_LEFT",
      "value": 2,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "left",
            "content": {
              "type": "SYMBOL",
              "name": "_statement"
            }
          },
          {
            "type": "STRING",
            "value": "||"
          },
          {
            "type": "FIELD",
            "name": "right",
            "content": {
              "type": "SYMBOL",
              "name": "_statement"
            }
          }
        ]
      }
    },
    "and_list": {
      "type": "PREC_LEFT",
      "value": 3,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "left",
            "content": {
              "type": "SYMBOL",
              "name": "_statement"
            }
          },
          {
            "type": "STRING",
            "value": "&&"
          },
          {
            "type": "FIELD",
            "name": "right",
            "content": {
              "type": "SYMBOL",
              "name": "_statement"
            }
          }
        ]
      }
    },
    "pipeline": {
      "type": "PREC_LEFT",
      "value": 4,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "left",
            "content": {
              "type": "SYMBOL",
              "name": "_statement"
            }
          },
          {
            "type": "STRING",
            "value": "|"
          },
          {
            "type": "FIELD",
            "name": "right",
            "content": {
              "type": "SYMBOL",
              "name": "_statement"
            }
          }
        ]
      }
    },
    "_unit": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "command"
        },
        {
          "type": "SYMBOL",
          "name": "block"
        },
        {
          "type": "SYMBOL",
          "name": "rem_comment"
        }
      ]
    },
    "block": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "("
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_block_body"
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "STRING",
            "value": ")"
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "FIELD",
              "name": "redirect",
              "content": {
                "type": "SYMBOL",
                "name": "redirection"
              }
            }
          }
        ]
      }
    },
    "_block_body": {
      "type": "SEQ",
      "members": [
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_newline"
          }
        },
        {
          "type": "SYMBOL",
          "name": "_statement"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "REPEAT1",
                "content": {
                  "type": "SYMBOL",
                  "name": "_newline"
                }
              },
              {
                "type": "SYMBOL",
                "name": "_statement"
              }
            ]
          }
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_newline"
          }
        }
      ]
    },
    "command": {
      "type": "PREC_RIGHT",
      "value": 5,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "FIELD",
                "name": "quiet",
                "content": {
                  "type": "SYMBOL",
                  "name": "quiet"
                }
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "FIELD",
              "name": "redirect",
              "content": {
                "type": "SYMBOL",
                "name": "redirection"
              }
            }
          },
          {
            "type": "FIELD",
            "name": "name",
            "content": {
              "type": "SYMBOL",
              "name": "command_name"
            }
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "FIELD",
                  "name": "argument",
                  "content": {
                    "type": "SYMBOL",
                    "name": "argument"
                  }
                },
                {
                  "type": "FIELD",
                  "name": "redirect",
                  "content": {
                    "type": "SYMBOL",
                    "name": "redirection"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "quiet": {
      "type": "STRING",
      "value": "@"
    },
    "redirection": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "redirect_file"
        },
        {
          "type": "SYMBOL",
          "name": "redirect_dup"
        }
      ]
    },
    "redirect_file": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "op",
          "content": {
            "type": "SYMBOL",
            "name": "redirect_operator"
          }
        },
        {
          "type": "FIELD",
          "name": "target",
          "content": {
            "type": "SYMBOL",
            "name": "argument"
          }
        }
      ]
    },
    "redirect_operator": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[0-9]?(?:>>|>|<)"
      }
    },
    "redirect_dup": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "op",
          "content": {
            "type": "SYMBOL",
            "name": "redirect_dup_operator"
          }
        },
        {
          "type": "FIELD",
          "name": "target",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "IMMEDIATE_TOKEN",
              "content": {
                "type": "PATTERN",
                "value": "[0-9]"
              }
            },
            "named": true,
            "value": "file_descriptor"
          }
        }
      ]
    },
    "redirect_dup_operator": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[0-9]?[<>]&"
      }
    },
    "command_name": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_cmd_lead"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_concat"
              },
              {
                "type": "SYMBOL",
                "name": "_fragment"
              }
            ]
          }
        }
      ]
    },
    "_cmd_lead": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_cmd_text"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "_expansion"
        }
      ]
    },
    "_cmd_text": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^ \\t\\r\\n&|<>()^\"%!@:][^ \\t\\r\\n&|<>()^\"%!]*"
      }
    },
    "argument": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_fragment"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_concat"
              },
              {
                "type": "SYMBOL",
                "name": "_fragment"
              }
            ]
          }
        }
      ]
    },
    "_fragment": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "text"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "escape_sequence"
        },
        {
          "type": "SYMBOL",
          "name": "_expansion"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_stray_sigil"
          },
          "named": true,
          "value": "text"
        }
      ]
    },
    "text": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^ \\t\\r\\n&|<>()^\"%!]+"
      }
    },
    "_stray_sigil": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[%!]"
      }
    },
    "escape_sequence": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\^[^\\r\\n]"
      }
    },
    "string": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\"[^\"\\r\\n]*\"?"
      }
    },
    "_expansion": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "variable"
        },
        {
          "type": "SYMBOL",
          "name": "delayed_variable"
        },
        {
          "type": "SYMBOL",
          "name": "parameter"
        },
        {
          "type": "SYMBOL",
          "name": "all_arguments"
        },
        {
          "type": "SYMBOL",
          "name": "parameter_tilde"
        },
        {
          "type": "SYMBOL",
          "name": "loop_variable"
        },
        {
          "type": "SYMBOL",
          "name": "percent_literal"
        }
      ]
    },
    "variable": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "%[^%0-9~*\\r\\n][^%\\r\\n]*%"
      }
    },
    "delayed_variable": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "![^!\\r\\n]+!"
      }
    },
    "parameter": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "%[0-9]"
      }
    },
    "all_arguments": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "%\\*"
      }
    },
    "parameter_tilde": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "%~[dpnxfsatzDPNXFSATZ]*(?:\\$[A-Za-z_][^:\\r\\n]*:)?[0-9]"
      }
    },
    "loop_variable": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "%%(?:~[dpnxfsatzDPNXFSATZ]*(?:\\$[A-Za-z_][^:\\r\\n]*:)?)?[A-Za-z]"
      }
    },
    "percent_literal": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "%%"
      }
    },
    "label": {
      "type": "SEQ",
      "members": [
        {
          "type": "TOKEN",
          "content": {
            "type": "PATTERN",
            "value": ":"
          }
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "_label_name"
            },
            "named": true,
            "value": "label_name"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_label_tail"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "_label_name": {
      "type": "IMMEDIATE_TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^ \\t\\r\\n:+;=,&|<>()]+"
      }
    },
    "_label_tail": {
      "type": "ALIAS",
      "content": {
        "type": "TOKEN",
        "content": {
          "type": "PATTERN",
          "value": "[^\\r\\n]+"
        }
      },
      "named": true,
      "value": "label_text"
    },
    "rem_comment": {
      "type": "SEQ",
      "members": [
        {
          "type": "TOKEN",
          "content": {
            "type": "PREC",
            "value": 2,
            "content": {
              "type": "PATTERN",
              "value": "[rR][eE][mM]"
            }
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "ALIAS",
              "content": {
                "type": "SYMBOL",
                "name": "_line_text"
              },
              "named": true,
              "value": "comment_text"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "colon_comment": {
      "type": "SEQ",
      "members": [
        {
          "type": "TOKEN",
          "content": {
            "type": "PATTERN",
            "value": "::"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "ALIAS",
              "content": {
                "type": "SYMBOL",
                "name": "_line_text"
              },
              "named": true,
              "value": "comment_text"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "_line_text": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^\\r\\n]+"
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[ \\t]"
    },
    {
      "type": "SYMBOL",
      "name": "line_continuation"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "_concat"
    }
  ],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}